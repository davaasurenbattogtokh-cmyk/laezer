# Server-only future QPay Merchant V2 configuration. No credentials are included.
# Keep local .env / .dev.vars files untracked; use Site runtime secrets when hosted.
QPAY_ENABLED=false
QPAY_ENVIRONMENT=sandbox
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# An HTTPS origin reachable by QPay, with no path, query, or trailing slash.
# The current owner-private Site gate blocks unauthenticated QPay callbacks.
QPAY_PUBLIC_ORIGIN=
# Generate a new independent random secret (at least 32 characters) at activation.
QPAY_CALLBACK_SECRET=
# This template is preparation only. Enabling the flag is insufficient:
# the Merchant API adapter, QR/deeplink UI and callback reachability must be completed.

# Shared application login. Store the salted hash as a secret, never plaintext.
ADMIN_LOGIN_NAME=admin
ADMIN_PASSWORD_HASH=
